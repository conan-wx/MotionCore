cmake_policy(SET CMP0007 NEW)
if(NOT DEFINED PHASE5_EXE OR NOT DEFINED OUTPUT_DIR)
    message(FATAL_ERROR "PHASE5_EXE and OUTPUT_DIR are required")
endif()
file(REMOVE_RECURSE "${OUTPUT_DIR}")
execute_process(COMMAND "${PHASE5_EXE}" --scenario nominal --output "${OUTPUT_DIR}"
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "phase5 nominal failed: ${stdout}\n${stderr}")
endif()
set(csv "${OUTPUT_DIR}/nominal.csv")
if(NOT EXISTS "${csv}")
    message(FATAL_ERROR "missing nominal.csv")
endif()
file(READ "${csv}" content)
string(REPLACE "\n" ";" lines "${content}")
list(LENGTH lines count)
if(count LESS 10)
    message(FATAL_ERROR "CSV has too few rows: ${count}")
endif()
list(GET lines 0 header)
foreach(column time_s motion_state command_id command_status x_ref_mm y_ref_mm z_ref_mm
        x_actual_mm y_actual_mm z_actual_mm vx_actual_mm_s vy_actual_mm_s vz_actual_mm_s
        drive_force_x_n drive_force_y_n drive_force_z_n homed_x homed_y homed_z
        following_error_mm fault_code fault_active soft_limit_margin_x_mm
        soft_limit_margin_y_mm soft_limit_margin_z_mm)
    string(FIND "${header}" "${column}" found)
    if(found LESS 0)
        message(FATAL_ERROR "CSV header misses ${column}")
    endif()
endforeach()
if(header MATCHES "jerk_ref_mm_s3")
    message(FATAL_ERROR "Phase5 CSV must not use obsolete jerk field")
endif()
find_program(PYTHON3_EXECUTABLE NAMES python3 python)
if(PYTHON3_EXECUTABLE)
    if(NOT DEFINED SOURCE_DIR)
        set(SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/../..")
    endif()
    execute_process(COMMAND "${PYTHON3_EXECUTABLE}" "${SOURCE_DIR}/tests/check_phase5_csv.py" "${csv}"
        RESULT_VARIABLE py_result OUTPUT_VARIABLE py_out ERROR_VARIABLE py_err)
    if(NOT py_result EQUAL 0)
        message(FATAL_ERROR "CSV numerical validation failed: ${py_out}\n${py_err}")
    endif()
else()
    message(WARNING "Python not found; structural CSV checks only")
endif()
message(STATUS "Phase5 CSV structure and nominal execution validated")
